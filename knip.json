{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/{layout,page,error,not-found,global-error,loading,default,robots,sitemap,manifest}.tsx",
    "src/app/**/{robots,sitemap,manifest}.ts",
    "src/app/**/route.ts",
    "src/i18n/request.ts",
    "src/proxy.ts",
    "src/config/env.ts",
    "scripts/run-checks.mjs",
    "scripts/check-list-tables.mjs",
    "scripts/code/*.cjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,cjs,js}"],
  "ignore": ["src/components/ui/**", "src/styles/**"],
  "ignoreDependencies": [
    "tw-animate-css",
    "tailwindcss",
    "@tailwindcss/postcss",
    "postcss",
    "@types/node",
    "@types/react",
    "@types/react-dom",
    "knip",
    "jscpd",
    "@babel/parser",
    "@babel/traverse",
    "@vercel/analytics",
    "@vercel/speed-insights"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "duplicates": "error",
    "cycles": "error"
  }
}
