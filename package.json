{
  "name": "ronaq-store-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3007",
    "build": "next build",
    "start": "next start -p 3007",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/code/test-loader.mjs --test src/lib/money/index.test.ts src/lib/api/envelope.test.ts src/lib/product-condition.test.ts src/lib/marketplace-filters.test.ts src/lib/shop-hours.test.ts src/lib/contact-links.test.ts src/lib/seo/json-ld.test.ts src/app/sitemap.test.ts",
    "check": "node scripts/run-checks.mjs",
    "knip": "node scripts/run-knip.mjs",
    "check:hydration": "node scripts/code/check-hydration.cjs",
    "check:unused": "node scripts/code/check-unused.cjs",
    "fix:unused": "node scripts/code/check-unused.cjs --fix",
    "check:orphans": "node scripts/code/check-orphans.cjs",
    "check:duplicates": "node scripts/code/check-duplicates.cjs",
    "duplicates": "jscpd --config .jscpd.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && npm run format",
    "lint:strict": "oxlint --deny-warnings",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "postcss": "8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jscpd": "^5.4.0",
    "knip": "^6.40.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.29"
  },
  "engines": {
    "node": ">=24"
  }
}
